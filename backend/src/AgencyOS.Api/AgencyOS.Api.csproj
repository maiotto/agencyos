  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgencyOS.Application\AgencyOS.Application.csproj" />
    <ProjectReference Include="..\AgencyOS.Infrastructure\AgencyOS.Infrastructure.csproj" />
    <ProjectReference Include="..\AgencyOS.Shared\AgencyOS.Shared.csproj" />
  </ItemGroup>

</Project>
